# Earthdata Login for the optional download scripts (NO2 from GES DISC, NDVI from AppEEARS).
# Nothing reads a .env file: set these two names as environment variables in your shell
# (PowerShell: $env:EARTHDATA_USERNAME = "..."), or put a machine urs.earthdata.nasa.gov entry
# in ~/.netrc (Windows: ~/_netrc). Never commit real values. The app itself needs no login.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
